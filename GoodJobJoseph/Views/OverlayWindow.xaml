<Window x:Class="JosephExperience.Views.OverlayWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="Overlay"
         WindowStyle="None"
         ResizeMode="NoResize"
         AllowsTransparency="True"
         Background="Transparent"
         ShowInTaskbar="False"
         Topmost="True"
         ShowActivated="False"
         Focusable="False"
         IsHitTestVisible="False"
         WindowStartupLocation="Manual"
         Loaded="OverlayWindow_Loaded">

    <Grid x:Name="OverlayGrid" Background="Transparent" ClipToBounds="False">
        <Grid x:Name="JosephPanel" Background="Transparent" ClipToBounds="False"
              RenderTransformOrigin="0.5,0.5"
              RenderOptions.ClearTypeHint="Enabled"
              RenderOptions.EdgeMode="Aliased">
            <Image x:Name="JosephImage"
                    RenderTransformOrigin="0.5,0.5"
                   RenderOptions.BitmapScalingMode="LowQuality"
                   RenderOptions.EdgeMode="Aliased"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
            <Border x:Name="GlowBorder" Background="Transparent" Opacity="0"
                     CornerRadius="20" Margin="0,0,0,30"
                     BorderBrush="{StaticResource AccentGlowBrush}"
                     BorderThickness="1"
                     Width="200" Height="200">
                <Border.Effect>
                    <BlurEffect Radius="20" RenderingBias="Quality"/>
                </Border.Effect>
            </Border>
            <TextBlock x:Name="CelebrationTextBlock"
                        FontFamily="Segoe UI Variable, Segoe UI"
                        FontWeight="Bold"
                        Foreground="{StaticResource AccentBrush}"
                        TextOptions.TextFormattingMode="Ideal"
                        TextOptions.TextRenderingMode="ClearType"
                        TextWrapping="NoWrap"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,10"
                        IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
