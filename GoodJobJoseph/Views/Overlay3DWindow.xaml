<Window x:Class="JosephExperience.Views.Overlay3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay3D"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        Loaded="Overlay3DWindow_Loaded">

    <Viewport3D x:Name="Viewport" ClipToBounds="False">
        <Viewport3D.Camera>
            <PerspectiveCamera x:Name="Cam" Position="0,0,4" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="45"/>
        </Viewport3D.Camera>

        <ModelVisual3D>
            <ModelVisual3D.Content>
                <AmbientLight Color="#404040"/>
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <DirectionalLight Color="#FFFFFF" Direction="-1,-1,-1"/>
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <DirectionalLight Color="#808080" Direction="1,1,-0.5"/>
            </ModelVisual3D.Content>
        </ModelVisual3D>

        <!-- Optional reference grid (hidden by default, shown in code) -->
        <ModelVisual3D x:Name="GridVisual"/>

        <!-- The loaded model gets inserted here -->
        <ModelVisual3D x:Name="ModelVisual"/>
    </Viewport3D>
</Window>