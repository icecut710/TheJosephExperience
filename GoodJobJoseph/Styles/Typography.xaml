<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
    </Style>

    <!-- ============================================================= -->
    <!-- TYPOGRAPHY SCALES                                             -->
    <!-- ============================================================= -->
    <Style x:Key="Display1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="72"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="Display2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="56"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="Title1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="Title2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
    </Style>

    <Style x:Key="Title3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
    </Style>

    <Style x:Key="Body1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
    </Style>

    <Style x:Key="Body2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
    </Style>

    <Style x:Key="LabelSmall" TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
    </Style>

</ResourceDictionary>
