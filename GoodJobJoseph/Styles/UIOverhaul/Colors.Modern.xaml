<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Accent: soft-lavender to reduce eye-strain vs. saturated purple -->
  <Color x:Key="AccentHueColor">#FF9D82E0</Color> <!-- HSL(261, 52%, 61%) -->

  <!-- Surface temperature: cool-leaning dark stack -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF0A0A0D"/>   <!-- near-near black -->
  <SolidColorBrush x:Key="CardBackgroundBrush"  Color="#FF16161C"/>   <!-- card surface -->
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FF0E0E12"/> <!-- sidebar -->
  <LinearGradientBrush x:Key="TitleBarGradientBrush">
    <GradientStop Color="#FF0A0A0D" Offset="0"/>
    <GradientStop Color="#FF16161C" Offset="0.5"/>
    <GradientStop Color="#0E0E12" Offset="1"/>
  </LinearGradientBrush>

  <!-- Grays: temperature-accurate -->
  <SolidColorBrush x:Key="TextPrimaryBrush"  Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB8BAC5"/>
  <SolidColorBrush x:Key="TextMutedBrush"    Color="#FF7C8294"/>
  <SolidColorBrush x:Key="BorderBrush"       Color="#FF2A2E37"/>

  <!-- Elevation -->
  <DropShadowEffect x:Key="CardShadow"
                    Color="#FF000000"
                    ShadowDepth="0"
                    BlurRadius="12"
                    Opacity="0.25"
                    RenderingBias="Quality"/>

  <!-- Button states -->
  <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF8B7DE9" Offset="0"/> <!-- lavender -->
    <GradientStop Color="#FF9D82E0" Offset="1"/>
  </LinearGradientBrush>

  <!-- Chart-specific -->
  <LinearGradientBrush x:Key="BarGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF8B7DE9" Offset="0"/>
    <GradientStop Color="#FF6C63A4" Offset="1"/>
  </LinearGradientBrush>

</ResourceDictionary>
